# Gemini is used only to generate grounded answers.
GEMINI_API_KEY=
GEMINI_GENERATION_MODEL=
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# Local embeddings (default): requires Ollama with qwen3-embedding:0.6b pulled.
EMBEDDING_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b
OLLAMA_REQUEST_TIMEOUT_SECONDS=120

EMBEDDING_DIMENSION=1024
EMBEDDING_BATCH_SIZE=10
EMBEDDING_REQUESTS_PER_MINUTE=80
EMBEDDING_MAX_RETRIES=8
EMBEDDING_MAX_RETRY_DELAY_SECONDS=120

# Persistence and paths
POSTGRES_DB=lecture_notes
POSTGRES_USER=lecture_notes
POSTGRES_PASSWORD=lecture_notes_dev
DATABASE_URL=postgresql+psycopg://lecture_notes:lecture_notes_dev@localhost:5432/lecture_notes
CORPUS_ROOT=./data
RUNTIME_ROOT=./runtime

# Environment
APP_ENV=development
LOG_LEVEL=INFO
