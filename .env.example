# Gemini credentials and model selection
GEMINI_API_KEY=
GEMINI_GENERATION_MODEL=
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSION=1536
EMBEDDING_BATCH_SIZE=10
EMBEDDING_REQUESTS_PER_MINUTE=80
EMBEDDING_MAX_RETRIES=8
EMBEDDING_MAX_RETRY_DELAY_SECONDS=120

# Persistence and paths
POSTGRES_DB=lecture_notes
POSTGRES_USER=lecture_notes
POSTGRES_PASSWORD=lecture_notes_dev
DATABASE_URL=postgresql+psycopg://lecture_notes:lecture_notes_dev@localhost:5432/lecture_notes
CORPUS_ROOT=./data
RUNTIME_ROOT=./runtime

# Environment
APP_ENV=development
LOG_LEVEL=INFO
